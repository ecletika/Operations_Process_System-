APP_NAME="Operations Process System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ops
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=ops_session
# Minutos de inatividade ate a sessao expirar (480 = 8 horas, um dia de trabalho).
SESSION_LIFETIME_MINUTES=480

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
